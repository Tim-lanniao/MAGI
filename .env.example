# 从项目根目录启动。Mac 上请用权限 600 保存为 .env。
PORT=3000
RP_ID=magi.lanthan.cn
RP_NAME=MAGI
# 仅信任本机反代。
TRUST_PROXY=127.0.0.1
DB_PATH="~/Library/Application Support/MAGI/magi.db"
SESSION_ABSOLUTE_HOURS=24
SESSION_IDLE_HOURS=24
MODEL_TIMEOUT_SECONDS=600
# 可用中文或英文逗号分隔，设为空字符串可关闭提醒。
LINT_PHRASES=我觉得、我认为、我倾向、我打算、我已经决定、我更想、我更愿意、显然、肯定应该、毫无疑问

# 2026-11-18 官方模型目录。每个模型、推理档位均可独立更换。
# chatgpt_plan 使用已授权的个人 ChatGPT 套餐，api_key 使用下面的 OpenAI API Key。
OPENAI_AUTH_MODE=chatgpt_plan
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-astra
OPENAI_REASONING=max
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
# Responses API 的 reasoning.effort，max 同时开启思考并选择最高档。
DEEPSEEK_THINKING=max

# 以下配置供 standalone 部署（Caddy + 阿里云 DDNS）使用，其他部署方式可留空。
DDNS_DOMAIN=lanthan.cn
DDNS_RECORD=magi
DDNS_PROVIDER=alidns
# 仅授予本域 DescribeDomainRecords、UpdateDomainRecord 的 RAM AccessKey。
DDNS_API_ID=
DDNS_API_SECRET=
DDNS_IPV4=true
DDNS_IPV6=false
# 留空自动选择 Mac 的默认 IPv6 网络接口，也可指定 en0 等物理接口。
DDNS_INTERFACE=
