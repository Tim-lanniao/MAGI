{
  "name": "magi-decision-server",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p server/tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "start": "node server/dist/src/index.js",
    "dev": "tsx server/src/index.ts",
    "preview:web": "npm run build && node web/scripts/preview.mjs",
    "test": "vitest run",
    "test:browser": "npm run build && node server/test/browser.mjs",
    "test:web": "npm run build && node web/scripts/e2e.mjs",
    "invite": "node server/dist/scripts/invite.js",
    "chatgpt": "node server/dist/scripts/chatgpt.js",
    "reset-credentials": "node server/dist/scripts/reset-credentials.js",
    "ddns": "node deploy/ddns/update.mjs"
  },
  "dependencies": {
    "@alicloud/alidns20150109": "^4.0.0",
    "@alicloud/openapi-core": "^1.0.9",
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "@simplewebauthn/browser": "^13.2.0",
    "@simplewebauthn/server": "^13.2.0",
    "better-sqlite3": "^12.0.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "openai": "^6.49.0",
    "tldts": "7.5.4",
    "ulid": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "playwright-core": "^1.65.1",
    "tsx": "^4.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.8",
    "vitest": "^3.2.6"
  }
}
